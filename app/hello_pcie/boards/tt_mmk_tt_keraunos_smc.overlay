/*
 * Emul mtime is ~100 kHz vs CONFIG_SYS_CLOCK_HW_CYCLES_PER_SEC=1 MHz, so
 * cdns_i3c_bus_init()'s k_busy_wait(201) plus DAA/CCC timeouts miss a 10 ms
 * sim-time budget. This app does not use I3C.
 */
&i3c1 {
	status = "disabled";
};

&remoteproc {
	status = "disabled";
};

&{/soc} {
	sep_safe_off: scratch-reg@c0010168 {
		/* SCRATCH[13], SEP-safe SRAM offset in [13:0] */
		compatible = "tenstorrent,scratch-reg";
		reg = <0x0 0xc0010168 0x0 0x4>;
	};

	sep_safe_size: scratch-reg@c0010170 {
		/* SCRATCH[14], SEP-safe SRAM size */
		compatible = "tenstorrent,scratch-reg";
		reg = <0x0 0xc0010170 0x0 0x4>;
	};

	host_boot_state: scratch-reg@c0010160 {
		/* SCRATCH[12] */
		compatible = "tenstorrent,scratch-reg";
		reg = <0x0 0xc0010160 0x0 0x4>;
		status = "okay";
	};

	bundle_validation: scratch-reg@c0010150 {
		/* SCRATCH[10] */
		compatible = "tenstorrent,scratch-reg";
		reg = <0x0 0xc0010150 0x0 0x4>;
		status = "okay";
	};
};
